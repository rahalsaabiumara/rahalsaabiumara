---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{project.lessonsLearned.length > 0 && (
  <section class="section pd-lessons" id="lessons-learned">
    <div class="container">
      <div class="section-header">
        <div class="section-label reveal">REFLECTIONS</div>
        <h2 class="display-md reveal reveal-delay-1">LESSONS LEARNED</h2>
      </div>
      <div class="pd-lessons-grid">
        {project.lessonsLearned.map((lesson, i) => (
          <div class={`pd-lesson-card card reveal reveal-delay-${Math.min((i % 3) + 1, 4)}`}>
            <div class="pd-lesson-number">{String(i + 1).padStart(2, '0')}</div>
            <p class="pd-lesson-text">{lesson}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
