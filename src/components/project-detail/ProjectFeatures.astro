const defaultIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>';
---

<section class="section pd-features" id="features">
  <div class="container">
    <div class="section-header">
      <div class="section-label reveal">CAPABILITIES</div>
      <h2 class="display-md reveal reveal-delay-1">KEY FEATURES</h2>
    </div>
    <div class="pd-features-grid">
      {project.features.map((feature, i) => (
        <div class={`pd-feature-card card reveal reveal-delay-${Math.min((i % 3) + 1, 4)}`}>
          <div class="pd-feature-icon" set:html={(iconMap as any)[feature.icon] || defaultIcon} />
          <h3 class="pd-feature-title">{feature.title}</h3>
          <p class="pd-feature-desc">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
