---
import { projects } from '../data/projects';
---

<section class="section projects" id="projects">
  <div class="container">
    <div class="section-header">
      <div class="section-label reveal">SELECTED WORK</div>
      <h2 class="display-lg reveal reveal-delay-1">PROJECTS</h2>
    </div>

    <!-- Category Tabs -->
    <div class="project-tabs reveal reveal-delay-2">
      <button class="project-tab active" data-filter="all">ALL</button>
      <button class="project-tab" data-filter="ml">ML & Data Analysis</button>
      <button class="project-tab" data-filter="web">SOFTWARE & WEB DEVELOPMENT</button>
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid" id="projects-grid">
      {projects.map((project, i) => {
        const category = project.categories[0] || 'web';
        const delayClass = i % 3 > 0 ? `reveal-delay-${i % 3}` : '';
        
        // Determine tag color based on category
        const tagColor = category === 'ml' ? 'tag--accent' : 
                         category === 'web' ? 'tag--blue' : '';
        
        return (
          <div class={`project-card card reveal ${delayClass}`} data-category={category}>
            <a href={`/projects/${project.slug}`} class="project-card-link">
              <div class="card-image">
                <img src={project.thumbnail} alt={project.title} loading="lazy" />
              </div>
            </a>
            <div class="card-body">
              <div class="project-category">{category === 'ml' ? 'MACHINE LEARNING' : category === 'web' ? 'SOFTWARE DEVELOPMENT' : category.toUpperCase()}</div>
              <h3>{project.title}</h3>
              <p class="project-desc">{project.shortDescription}</p>
              <div class="project-tags">
                {project.technologies.slice(0, 3).map((tech, j) => (
                  <span class={`tag ${j < 2 ? tagColor : ''}`}>{tech.toUpperCase()}</span>
                ))}
              </div>
              <div class="project-links">
                {project.github && (
                  <a href={project.github} class="project-link" target="_blank" rel="noopener noreferrer">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                    CODE
                  </a>
                )}
                {project.liveDemo && (
                  <a href={project.liveDemo} class="project-link" target="_blank" rel="noopener noreferrer">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    LIVE DEMO
                  </a>
                )}
                <a href={`/projects/${project.slug}`} class="project-link project-link--details">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  SEE DETAILS
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Project filtering
  const tabs = document.querySelectorAll('.project-tab');
  const cards = document.querySelectorAll('.project-card');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Update active tab
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      const filter = tab.getAttribute('data-filter');

      cards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
